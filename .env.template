# Postal notification provider. Copy the keys you need into the backend's .env.
# Secrets (POSTAL_API_KEY, POSTAL_WEBHOOK_TOKEN) are read from the environment
# only and are never stored by the plugin. POSTAL_WEBHOOK_TOKEN is required:
# webhooks are rejected without it (generate one with `openssl rand -hex 32`).
POSTAL_AUTH_TYPE=smtp-api
POSTAL_FROM=
POSTAL_BASE_URL=
POSTAL_API_KEY=
POSTAL_WEBHOOK_TOKEN=
# Optional: Postal's RSA public key (PEM or JWK/JWKS JSON) to verify webhook signatures.
POSTAL_WEBHOOK_PUBLIC_KEY=
POSTAL_TEST_TO=
# Empty means off; `true` redirects every recipient to POSTAL_TEST_TO.
POSTAL_SANDBOX=
POSTAL_REQUEST_TIMEOUT_MS=10000
# Optional fallback origin for the absolute webhook callback URL in the admin.
MEDUSA_BACKEND_URL=

{
  "branches": [
    "main"
  ],
  "repositoryUrl": "https://gitlab.uhlhost.net/uhlhosting/medusa-notification-postal.git",
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "releaseRules": [
          {
            "type": "chore",
            "scope": "deps",
            "release": "patch"
          }
        ],
        "parserOpts": {
          "headerPattern": "^(\\w*)(?:\\((.*)\\))?!?: (.*)$",
          "headerCorrespondence": [
            "type",
            "scope",
            "subject"
          ],
          "breakingHeaderPattern": "^(\\w*)(?:\\((.*)\\))?!: (.*)$",
          "noteKeywords": [
            "BREAKING CHANGE",
            "BREAKING CHANGES"
          ]
        }
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "parserOpts": {
          "headerPattern": "^(\\w*)(?:\\((.*)\\))?!?: (.*)$",
          "headerCorrespondence": [
            "type",
            "scope",
            "subject"
          ],
          "breakingHeaderPattern": "^(\\w*)(?:\\((.*)\\))?!: (.*)$",
          "noteKeywords": [
            "BREAKING CHANGE",
            "BREAKING CHANGES"
          ]
        }
      }
    ],
    "@semantic-release/gitlab",
    [
      "@semantic-release/npm",
      {
        "npmPublish": true
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "package.json"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ]
  ]
}
